---
import Base from '../layouts/Base.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero';
import QuickCTA from '../components/sections/QuickCTA';
import Services from '../components/sections/Services';
import Dentists from '../components/sections/Dentists';
import Technology from '../components/sections/Technology';
import WhyChooseUs from '../components/sections/WhyChooseUs';
import Pricing from '../components/sections/Pricing.astro';
import FirstTimePatient from '../components/sections/FirstTimePatient';
import Testimonial from '../components/sections/Testimonial';
import FAQ from '../components/sections/FAQ';
import BookingCTA from '../components/sections/BookingCTA';
---

<Base>
  <Navbar />
  <main>
    <Hero client:load />
    <QuickCTA client:visible />
    <Services client:visible />
    <Dentists client:visible />
    <Technology client:visible />
    <WhyChooseUs client:visible />
    <Pricing />
    <FirstTimePatient client:visible />
    <Testimonial client:visible />
    <FAQ client:visible />
    <BookingCTA client:idle />
  </main>
  <Footer />
</Base>
