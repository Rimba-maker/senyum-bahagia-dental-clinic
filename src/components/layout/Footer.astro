---
import { url } from '../../lib/img';
const services = [
  'General Dentistry', 'Cosmetic Dentistry', 'Orthodontic (Behel)',
  'Endodontic (Root Canal)', 'Periodontic (Gusi)', 'Prosthodontic (Gigi Palsu)',
  'Oral Surgery', 'Pediatric Dentistry',
];
const branches = [
  { name: 'Kelapa Gading', address: 'Jakarta Utara' },
  { name: 'Kuningan', address: 'Jakarta Selatan' },
  { name: 'BSD', address: 'Tangerang Selatan' },
  { name: 'Bintaro', address: 'Tangerang Selatan' },
  { name: 'Bekasi', address: 'Bekasi' },
];
---

<footer class="foot" id="lokasi">
  <div class="container">
    <div class="foot__grid">
      <div class="stack">
        <a href={url('/')} class="brand">
          <svg width="26" height="30" viewBox="12 6 24 28" fill="currentColor" aria-hidden="true" style="color: var(--color-accent-soft)">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M24 8c-3.5 0-6.5 1.5-8 4-1 1.8-1 3.8-.5 6l2 9c.4 2 1.5 3 2.5 3s1.8-.8 2-2.5l1-5 1 5c.2 1.7 1 2.5 2 2.5s2.1-1 2.5-3l2-9c.5-2.2.5-4.2-.5-6-1.5-2.5-4.5-4-8-4z"/>
          </svg>
          <span><b>Senyum Bahagia</b><small class="sub">Dental Clinic</small></span>
        </a>
        <p class="sub">Setiap senyum, masa depan yang lebih percaya diri.</p>
        <ul>
          <li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer">Instagram</a></li>
          <li><a href="#" target="_blank" rel="noopener noreferrer">TikTok</a></li>
          <li><a href="#" target="_blank" rel="noopener noreferrer">YouTube</a></li>
        </ul>
        <p class="sub">PDGI Member, BPJS Friendly</p>
      </div>

      <div>
        <h3>Layanan</h3>
        <ul>{services.map((s) => <li><a href="#layanan">{s}</a></li>)}</ul>
      </div>

      <div>
        <h3>Cabang</h3>
        <ul>{branches.map((b) => <li>{b.name}<span class="sub" style="display:block">{b.address}</span></li>)}</ul>
        <p class="sub" style="margin-top: var(--space-md)">
          Jam operasional<br />
          Senin – Sabtu: 09:00 – 21:00<br />
          Minggu: 10:00 – 18:00
        </p>
      </div>

      <div>
        <h3>Kontak</h3>
        <ul>
          <li><a href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer">WhatsApp</a><span class="sub" style="display:block">0812-3456-7890</span></li>
          <li><a href="mailto:halo@senyumbahagia.id">Email</a><span class="sub" style="display:block">halo@senyumbahagia.id</span></li>
        </ul>
        <p class="sub" style="margin-top: var(--space-md)">Walk-in same day tersedia di semua cabang. Hubungi kami segera.</p>
      </div>
    </div>

    <div class="foot__base">
      <p>© 2024 Senyum Bahagia Dental Clinic. Semua hak dilindungi.</p>
      <nav aria-label="Legal">
        <a href="#">Kebijakan Privasi</a>
        <a href="#">Syarat & Ketentuan</a>
      </nav>
    </div>
    <p class="sub" data-credits style="margin-top: var(--space-md); font-size: var(--text-xs)">Foto: Pexels (lisensi bebas pakai). Foto sementara, ganti dengan foto klinik sendiri.</p>
  </div>
</footer>
