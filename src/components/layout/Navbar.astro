---
import { url } from '../../lib/img';
const navLinks = [
  { label: 'Layanan', href: '#layanan' },
  { label: 'Dokter', href: '#dokter' },
  { label: 'Teknologi', href: '#teknologi' },
  { label: 'Harga', href: '#harga' },
  { label: 'Lokasi', href: '#lokasi' },
];
---

<header class="nav" id="navbar">
  <div class="container nav__row">
    <a href={url('/')} class="brand">
      <svg width="26" height="30" viewBox="12 6 24 28" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M24 8c-3.5 0-6.5 1.5-8 4-1 1.8-1 3.8-.5 6l2 9c.4 2 1.5 3 2.5 3s1.8-.8 2-2.5l1-5 1 5c.2 1.7 1 2.5 2 2.5s2.1-1 2.5-3l2-9c.5-2.2.5-4.2-.5-6-1.5-2.5-4.5-4-8-4z"/>
      </svg>
      <span><b>Senyum Bahagia</b><small>Dental Clinic</small></span>
    </a>

    <nav class="nav__links" aria-label="Utama">
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav__cta">
      <a href="#booking" class="btn btn--primary btn--sm">Book Appointment</a>
      <details class="nav__menu" id="mobile-menu">
        <summary aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <nav aria-label="Menu seluler">
          {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href="#booking" class="btn btn--primary">Book Appointment</a>
        </nav>
      </details>
    </div>
  </div>
</header>
