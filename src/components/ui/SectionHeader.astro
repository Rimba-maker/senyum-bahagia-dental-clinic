---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  dark?: boolean;
}

const { eyebrow, title, subtitle, align = 'center', dark = false } = Astro.props;

const titleColor = dark ? 'text-white' : 'text-[#1A2E35]';
const subtitleColor = dark ? 'text-white/70' : 'text-[#4A5A60]';
const eyebrowColor = dark ? 'text-[#4AABB5]' : 'text-[#0B9FAA]';
const alignClass = align === 'center' ? 'text-center items-center' : 'text-left items-start';
---

<div class={`flex flex-col gap-3 ${alignClass} ${align === 'center' ? 'mx-auto max-w-2xl' : ''}`}>
  {eyebrow && (
    <span class={`text-xs font-semibold tracking-widest uppercase ${eyebrowColor}`}>
      {eyebrow}
    </span>
  )}
  <h2 class={`font-display font-bold leading-tight ${titleColor}`} style="font-size: clamp(28px, 4vw, 40px)">
    {title}
  </h2>
  {subtitle && (
    <p class={`text-lg leading-relaxed ${subtitleColor}`}>
      {subtitle}
    </p>
  )}
</div>
