---
interface Props {
  variant?: 'primary' | 'secondary' | 'outline-white';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
  type?: 'button' | 'submit';
}

const {
  variant = 'primary',
  size = 'md',
  href,
  class: className = '',
  type = 'button',
} = Astro.props;

const base = 'inline-flex items-center justify-center gap-2 font-semibold rounded-full transition-all duration-200 cursor-pointer';

const variants = {
  primary: 'bg-[#0B9FAA] text-white hover:bg-[#0A3D45] active:scale-[0.97]',
  secondary: 'bg-transparent border-2 border-[#0B9FAA] text-[#0B9FAA] hover:bg-[#E0F5F7] active:scale-[0.97]',
  'outline-white': 'bg-transparent border-2 border-white text-white hover:bg-white/10 active:scale-[0.97]',
};

const sizes = {
  sm: 'px-5 py-2 text-sm',
  md: 'px-7 py-3 text-base',
  lg: 'px-8 py-[14px] text-base',
};

const classes = [base, variants[variant], sizes[size], className].join(' ');
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
